PROJECT_NAME           = mech_console
PROJECT_BRIEF          = "ESP32-C3-LCDkit application API"
OUTPUT_DIRECTORY       = build-docs/site/ESP32/mech_console
INPUT                  = docs/api.md docs/protocol.md docs/hardware.md docs/roadmap.md
USE_MDFILE_AS_MAINPAGE  = docs/api.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
# Public headers also contain static inline APIs.
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
SHOW_INCLUDE_FILES     = NO
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC  = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
